+def test_finished_fixture_without_prediction_is_silently_archived(monkeypatch):
+    import runner
+    monkeypatch.setattr(runner, 'now', lambda: NOW)
+    match = {
+        'id': 999, 'utcDate': (NOW - timedelta(days=56)).isoformat(),
+        'status': 'FINISHED',
+        'homeTeam': {'name': 'Club Brugge KV'},
+        'awayTeam': {'name': 'Aston Villa FC'},
+    }
+    state = {}
+    bot = FakeTelegram()
+    track_missed_fixtures([match], {}, state, bot, '10', lambda: None)
+    assert bot.calls == []
+    notice = state['tracked_fixtures']['999']['missed_notice']
+    assert notice['suppressed'] is True
+    assert notice['suppression_reason'] == 'FINISHED_WITHOUT_PREMATCH_PREDICTION'
+
